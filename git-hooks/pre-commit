#!/bin/sh
# Global pre-commit: lint added lines in staged prose files, then chain to the repo's own hook.
# Warn-only by default; export AI_STYLE_GIT_BLOCK=1 to make errors block the commit.
python3 "$HOME/.config/ai-style/prose_lint.py" --git-staged || [ "${AI_STYLE_GIT_BLOCK:-}" != "1" ] || exit 1
repo_hook="$(git rev-parse --git-common-dir)/hooks/pre-commit"
[ -x "$repo_hook" ] && exec "$repo_hook" "$@"
exit 0
