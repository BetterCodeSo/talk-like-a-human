#!/bin/sh
# Global commit-msg: lint the message, then chain to the repo's own hook.
# Warn-only by default; export AI_STYLE_GIT_BLOCK=1 to make errors block the commit.
python3 "$HOME/.config/ai-style/prose_lint.py" --commit-msg "$1" || [ "${AI_STYLE_GIT_BLOCK:-}" != "1" ] || exit 1
repo_hook="$(git rev-parse --git-common-dir)/hooks/commit-msg"
[ -x "$repo_hook" ] && exec "$repo_hook" "$@"
exit 0
